{
  "name": "template-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "format": "prettier -w -c .",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "type-check": "npx tsc --noEmit",
    "ci": "yarn format && yarn lint && yarn type-check",
    "prepare": "husky",
    "gen-icons": "node scripts/gen-icons.js",
    "gen-api": "npx tsx scripts/gen-api/main.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "preinstall": "npx only-allow yarn",
    "clean": "yarn cache clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "lint-format": "eslint --exit-on-fatal-error --fix ./src && prettier --write \"**/*.{js,jsx,ts,tsx,mdx}\" --cache"
  },
  "dependencies": {
