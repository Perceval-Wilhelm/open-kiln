{
  "name": "open-kiln",
  "private": true,
  "version": "1.0.0",
  "description": "Open Kiln CSR campaign assessment demo with fictional treatment evidence.",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "yarn runtime:check && next dev",
    "build": "yarn runtime:check && next build",
    "start": "yarn runtime:check && next start",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn runtime:check && yarn format:check && yarn lint && yarn type-check && yarn test && yarn test:tooling",
    "check:all": "yarn check && yarn build",
    "runtime:check": "node scripts/check-runtime.mjs",
    "test:tooling": "node --test scripts/lint.test.mjs",
    "test:e2e": "yarn runtime:check && playwright test",
    "test:e2e:ui": "yarn runtime:check && playwright test --ui",
    "verify": "yarn check:all && yarn test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.20.5",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependenciesMeta": {
    "unrs-resolver": {
      "built": true
    }
  }
}
